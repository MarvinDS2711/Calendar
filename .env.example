# Port HTTP de l'application
PORT=3000
# Compte administrateur créé au PREMIER démarrage (si aucun admin n'existe)
ADMIN_EMAIL=admin@inovacom.fr
ADMIN_PASSWORD=changez-moi-tout-de-suite
# Nom affiché (en attendant le logo, et dans les textes)
COMPANY_NAME=INOVACOM
# Emplacement de la base SQLite (doit être sur un disque persistant)
DATABASE_PATH=./data/inovacom.db
# Dossier contenant logo.png / logo.svg
BRANDING_DIR=./branding
# Derrière un reverse proxy (Nginx, Render, Railway, Traefik…) : 1
TRUST_PROXY=1
# Cookies "Secure" (HTTPS). true par défaut en production. Mettre false uniquement pour un test en HTTP local.
# SECURE_COOKIES=true
# Durée de session admin (heures)
SESSION_TTL_HOURS=12
